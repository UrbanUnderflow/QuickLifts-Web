NEXT_PUBLIC_SIMPBUDGET_FIREBASE_APP_ID=1:354650749412:web:6da9fbef94bcad08d6ff1

NEXT_PUBLIC_OPENAI_API_KEY=

# Stripe checkout. Use test keys locally and live keys in production.
STRIPE_TEST_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_SECRET_COACH=

# PulseCheck readiness assessment products. Product IDs are optional when the
# Stripe secret key is present because the checkout API can find products by
# name; Payment Links provide a no-secret fallback for local/manual testing.
STRIPE_PARENT_READINESS_ASSESSMENT_PRODUCT_ID=prod_UefwD52sXIdOj9
STRIPE_COACH_READINESS_ASSESSMENT_PRODUCT_ID=prod_UefwKLRzHe8JzK
STRIPE_ATHLETIC_TRAINER_READINESS_ASSESSMENT_PRODUCT_ID=prod_UefxfafMy7e6UZ
STRIPE_PARENT_READINESS_ASSESSMENT_PAYMENT_LINK=
STRIPE_COACH_READINESS_ASSESSMENT_PAYMENT_LINK=
STRIPE_ATHLETIC_TRAINER_READINESS_ASSESSMENT_PAYMENT_LINK=

# Provider-neutral clinical bridge. AuntEdna/MANAS is the current provider.
CLINICAL_BRIDGE_PROVIDER=auntedna
CLINICAL_BRIDGE_BASE_URL=https://partner-api.manasinsights.me/partner
CLINICAL_BRIDGE_API_KEY=
CLINICAL_BRIDGE_CALLBACK_URL=
CLINICAL_BRIDGE_MOCK=
CLINICAL_BRIDGE_WEBHOOK_SECRET=

# Backward-compatible legacy AuntEdna env names. Prefer CLINICAL_BRIDGE_* for new config.
AUNTEDNA_PARTNER_API_URL=
AUNTEDNA_API_KEY=
AUNTEDNA_MOCK=

BREVO_MARKETING_KEY=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=tre@fitwithpulse.ai
PULSECHECK_PAYOUT_ADMIN_EMAILS=tre@fitwithpulse.ai
PULSECHECK_APPLE_COMMISSION_PCT=15

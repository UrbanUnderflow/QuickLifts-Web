OURA_SCOPES=daily
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
GOOGLE_HEALTH_OAUTH_SECRET_NAME=GOOGLE_HEALTH_OAUTH_CLIENT
GOOGLE_HEALTH_SECRET_MANAGER_PROJECT_ID=quicklifts-dd3f1

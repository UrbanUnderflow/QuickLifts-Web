rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /simpbudget-users/{userId} {
      allow read, write: if isOwner(userId);

      match /budgetSpaces/{spaceId} {
        allow read, write: if isOwner(userId);
      }

      match /budgets/{budgetId} {
        allow read, write: if isOwner(userId);
      }

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /pipeListShares/{shareId} {
      function isSharePathOwner() {
        return isSignedIn() && shareId.matches('^' + request.auth.uid + '-.*');
      }

      function isShareOwner() {
        return isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function isCreateOwner() {
        return isSharePathOwner()
          && request.auth.token.email != null
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerEmail == request.auth.token.email;
      }

      function hasStableOwnerEnvelope() {
        return request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerEmail == resource.data.ownerEmail;
      }

      function isProtectedPublicProjection() {
        return resource.data.get('protectedDetails', false) == true
          || request.resource.data.get('protectedDetails', false) == true
          || resource.data.get('editorEmails', []).size() > 0
          || request.resource.data.get('editorEmails', []).size() > 0
          || resource.data.list.templateKey == 'university-pilot'
          || request.resource.data.list.templateKey == 'university-pilot';
      }

      function isInvitedViewer() {
        return isSignedIn()
          && request.auth.token.email != null
          && (
            request.auth.token.email in resource.data.viewerEmails
            || request.auth.token.email in resource.data.editorEmails
          );
      }

      function isInvitedEditor() {
        return isSignedIn()
          && request.auth.token.email != null
          && request.auth.token.email in resource.data.editorEmails;
      }

      function isAcceptingOwnInvite() {
        return isSignedIn()
          && request.auth.token.email != null
          && (
            request.auth.token.email in resource.data.viewerEmails
            || request.auth.token.email in resource.data.editorEmails
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'inviteStatuses',
            'updatedAt'
          ])
          && request.resource.data.inviteStatuses
            .diff(resource.data.inviteStatuses)
            .affectedKeys()
            .hasOnly([request.auth.token.email])
          && request.resource.data.inviteStatuses[request.auth.token.email].email == request.auth.token.email
          && request.resource.data.inviteStatuses[request.auth.token.email].status == 'accepted';
      }

      allow read: if isSharePathOwner()
        || resource.data.publicRead == true
        || isShareOwner()
        || isInvitedViewer();
      allow create: if isCreateOwner();
      allow update: if (isShareOwner() && hasStableOwnerEnvelope())
        || isAcceptingOwnInvite()
        || (
          isInvitedEditor()
          && !isProtectedPublicProjection()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'list',
            'updatedAt',
            'lastEditedBy'
          ])
        );
      allow delete: if isShareOwner();
    }

    match /pipeListProtectedShares/{shareId} {
      function sourceShare() {
        return get(/databases/$(database)/documents/pipeListShares/$(shareId)).data;
      }

      function sourceShareAfterWrite() {
        return getAfter(/databases/$(database)/documents/pipeListShares/$(shareId)).data;
      }

      function isProtectedShareOwner() {
        return isSignedIn() && sourceShare().ownerUid == request.auth.uid;
      }

      function isProtectedShareOwnerAfterWrite() {
        return isSignedIn() && sourceShareAfterWrite().ownerUid == request.auth.uid;
      }

      function isProtectedShareViewer() {
        return isSignedIn()
          && request.auth.token.email != null
          && (
            request.auth.token.email in sourceShare().viewerEmails
            || request.auth.token.email in sourceShare().editorEmails
          );
      }

      function isProtectedShareEditor() {
        return isSignedIn()
          && request.auth.token.email != null
          && request.auth.token.email in sourceShare().editorEmails;
      }

      function hasValidProtectedEnvelope() {
        return request.resource.data.ownerUid == sourceShareAfterWrite().ownerUid
          && request.resource.data.ownerEmail == sourceShareAfterWrite().ownerEmail
          && request.resource.data.listId == sourceShareAfterWrite().list.id
          && request.resource.data.list.id == sourceShareAfterWrite().list.id
          && request.resource.data.lastEditedBy.uid == request.auth.uid
          && request.resource.data.lastEditedBy.email == request.auth.token.email;
      }

      allow read: if isProtectedShareOwner() || isProtectedShareViewer();
      allow create: if (isProtectedShareOwnerAfterWrite() || isProtectedShareEditor())
        && hasValidProtectedEnvelope();
      allow update: if (isProtectedShareOwner() || isProtectedShareEditor())
        && hasValidProtectedEnvelope()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'list',
          'lastEditedBy',
          'updatedAt'
        ]);
      allow delete: if isProtectedShareOwner();
    }

    match /pipeLeadShares/{shareId} {
      function isLeadSharePathOwner() {
        return isSignedIn() && shareId.matches('^' + request.auth.uid + '-.*');
      }

      function isLeadShareOwner() {
        return isSignedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function isLeadShareCreateOwner() {
        return isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      }

      allow read: if isLeadSharePathOwner() || resource.data.publicRead == true || isLeadShareOwner();
      allow create: if isLeadShareCreateOwner();
      allow update, delete: if isLeadShareOwner();
    }

    match /pipeListProfiles/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

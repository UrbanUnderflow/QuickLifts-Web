rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null && !exists(/databases/$(database)/documents/account-closure-jobs/$(request.auth.uid));
    }

    function hasEmail() {
      return isSignedIn() && request.auth.token.email != null;
    }

    function isAdminUser() {
      return hasEmail()
        && exists(/databases/$(database)/documents/admin/$(request.auth.token.email));
    }

    function isValidNorthStarPayload() {
      return request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.objectives is list;
    }

    function isAdminManagedPublicReadCollection(collectionName) {
      return collectionName in [
        'app-config',
        'authorProfiles',
        'daily-reflections',
        'legal-documents',
        'macra-version',
        'macra-versions',
        'pageMetaData',
        'pressKitData',
        'pressReleases',
        'pulsecheck-version',
        'pulsecheck-versions',
        'researchArticles',
        'shortLinks',
        'version',
        'versions'
      ];
    }

    function isAdminOnlyCollection(collectionName) {
      return collectionName in [
        'agent-commands',
        'agent-deliverables',
        'agent-group-chats',
        'agent-interventions',
        'agent-onboarding',
        'agent-outcomes',
        'agent-presence',
        'agent-tasks',
        'corporate-partners',
        'creator-prospects',
        'email-sequence-config',
        'email-templates',
        'equity-convertible-notes',
        'equity-documents',
        'equity-grants',
        'equity-pool',
        'equity-stakeholders',
        'errorLogs',
        'fitnessSeeker_leads',
        'founder-budgets',
        'friends-business-updates',
        'friends-of-business',
        'functionMetadata',
        'investorAccess',
        'investorAccessLogs',
        'lead-list-items',
        'lead-lists',
        'lead-massage-jobs',
        'notification-logs',
        'northstar-proposed-objectives',
        'outreach_campaigns',
        'payoutRecords',
        'progress-timeline',
        'pulsecheck-conversation-tree',
        'pulsecheck-nora-translation-log',
        'pulsecheck-off-limits-config',
        'pulsecheck-translation-table',
        'pulsecheck-user-revenue-summaries',
        'researchArticleAccess',
        'revenue-calculations',
        'university-prospects',
        'venture-prospects'
      ];
    }

    function isPurchaseLogCollection(collectionName) {
      return collectionName in [
        'Macra-purchase-logs',
        'PulseRitual-purchase-logs'
      ];
    }

    function isLockedPrivateCollection(collectionName) {
      return collectionName in [
        'admin',
        'beta',
        'payments',
        'subscriptions'
      ];
    }

    function isExplicitlyRuledCollection(collectionName) {
      // Staff reports are accessible only through role-checked server APIs.

      return collectionName in ['pulsecheck-organizations','pulsecheck-teams','pulsecheck-pilots','pulsecheck-pilot-cohorts','pulsecheck-organization-memberships'] || collectionName in ['pulsecheck-daily-assignments', 'pulsecheck-training-plans', 'sim-assignments', 'mental-exercise-assignments', 'conversations', 'conversationSummaries', 'user-mental-notes', 'state-snapshots', 'conversation-derived-signal-events'] || collectionName in ['mental-check-ins', 'pulsecheck-morning-checkins', 'dailySentimentAnalysis', 'health-context-source-records', 'health-context-source-status', 'health-context-snapshots', 'health-context-snapshot-revisions', 'health-context-assembly-traces', 'pulsecheck-oura-connections', 'pulsecheck-whoop-connections', 'pulsecheck-polar-connections', 'health-provider-connections', 'pulsecheck-oauth-states'] || collectionName in [
        'escalation-records','users', 'pulsecheck-private-users', 'account-closure-jobs', 'pulsecheck-invite-accepted-outbox', 'pulsecheck-clinical-escalations', 'pulsecheck-athlete-safety-state', 'pulsecheck-push-installations', 'pulsecheck-pilot-enrollments'] || collectionName == 'coach-team-insight-reports' || collectionName in ['groupMeetBookingSettings', 'groupMeetBookings', 'groupMeetBookingLimits'] || collectionName == 'pulsecheck-evidence-journals' || collectionName == 'pulsecheck-linear-curriculum' || collectionName == 'pulsecheck-restricted-questionnaire-submissions' || collectionName.matches('nora-red-team-.*') || collectionName in [
        'beta-applications',
        'partner-api-access-requests',
        'partner-api-keys',
        'partner-api-key-audit',
        'partner-api-key-rate-limits',
        'developerDocsUnlockAttempts',
        'systemOverviewShareLinks',
        'systemOverviewShareUnlockAttempts',
        'athleticmind-snapshot-pulls',
        'athleticmind-snapshots',
        'athleticmind-snapshot-deliveries',
        'athleticmind-snapshot-watermarks',
        'athleticmind-snapshot-scheduler',
        'coach-nora-vault',
        'coach-team-schedule',
        'company-config',
        'document-notes',
        'programming-access',
        'pulsecheck-invite-activities',
        'pulsecheck-invite-links',
        'pulsecheck-team-memberships',
        'round-exports',
        'signingRequests',
        'user-reports'
      ] || isAdminManagedPublicReadCollection(collectionName)
        || isAdminOnlyCollection(collectionName)
        || isPurchaseLogCollection(collectionName)
        || isLockedPrivateCollection(collectionName);
    }

    // PulseCheck provisioning helpers. Membership docs are keyed `${teamId}_${uid}`,
    // so the requester's own membership on a team is a deterministic lookup.
function pcTeamPath(teamId) {
      return /databases/$(database)/documents/pulsecheck-teams/$(teamId);
    }
    function pcOrganizationPath(organizationId) {
      return /databases/$(database)/documents/pulsecheck-organizations/$(organizationId);
    }
    function pcOrganizationNotDecommissioned(organizationId) {
      return organizationId is string
        && exists(pcOrganizationPath(organizationId))
        && get(pcOrganizationPath(organizationId)).data.get('lifecycleState', null) == null
        && get(pcOrganizationPath(organizationId)).data.get('deletedAt', null) == null;
    }
    function pcLifecycleScopeOpen(data) {
      let organizationId = data.get('organizationId', '');
      let teamId = data.get('teamId', '');
      return (organizationId == '' || organizationId == null
          || !exists(pcOrganizationPath(organizationId)) || pcOrganizationNotDecommissioned(organizationId))
        && (teamId == '' || teamId == null || !exists(pcTeamPath(teamId))
          || pcOrganizationNotDecommissioned(get(pcTeamPath(teamId)).data.organizationId));
    }
    function pcMembershipDataIsActive(data) {
      return (!('status' in data) || data.status == 'active')
        && (!('revokedAt' in data) || data.revokedAt == null);
    }
    function pcTeamIsActive(teamId) {
      return exists(pcTeamPath(teamId))
        && get(pcTeamPath(teamId)).data.status == 'active'
        && (!('archivedAt' in get(pcTeamPath(teamId)).data)
          || get(pcTeamPath(teamId)).data.archivedAt == null)
        && (!('deletedAt' in get(pcTeamPath(teamId)).data)
          || get(pcTeamPath(teamId)).data.deletedAt == null);
    }
    function pcTeamOrganizationIsActive(teamId) {
      let team = get(pcTeamPath(teamId)).data;
      return pcTeamIsActive(teamId)
        && team.organizationId is string
        && team.organizationId.size() > 0
        && exists(pcOrganizationPath(team.organizationId))
        && get(pcOrganizationPath(team.organizationId)).data.status == 'active'
        && (!('archivedAt' in get(pcOrganizationPath(team.organizationId)).data)
          || get(pcOrganizationPath(team.organizationId)).data.archivedAt == null)
        && (!('deletedAt' in get(pcOrganizationPath(team.organizationId)).data)
          || get(pcOrganizationPath(team.organizationId)).data.deletedAt == null);
    }
    function pcDataMatchesTeamOrganization(data, teamId) {
      return pcTeamOrganizationIsActive(teamId)
        && data.organizationId is string
        && data.organizationId == get(pcTeamPath(teamId)).data.organizationId;
    }
    function pcHasActiveTeamMembership(teamId) {
      let membership = get(pcMembershipPath(teamId)).data;
      let team = get(pcTeamPath(teamId)).data;
      return isSignedIn()
        && exists(pcMembershipPath(teamId))
        && pcTeamOrganizationIsActive(teamId)
        && membership.userId == request.auth.uid
        && membership.teamId == teamId
        && membership.organizationId == team.organizationId
        && pcMembershipDataIsActive(membership);
    }
    function pcTeamScopedDataIsActive(data) {
      return data.teamId is string
        && data.organizationId is string
        && pcDataMatchesTeamOrganization(data, data.teamId);
    }
    function pcMembershipPath(teamId) {
      return /databases/$(database)/documents/pulsecheck-team-memberships/$(teamId + '_' + request.auth.uid);
    }
    // Managing the team (inviting staff, assigning permissions) is admin-only.
    // The legacy 'team-admin' role is the org founder/full-access seat and keeps
    // access; the 'admin' staff capability is the new superuser grant. Manager
    // ('administrative') and 'coaching' no longer manage the team.
    function pcCanManageTeam(teamId) {
      return isSignedIn() && pcHasActiveTeamMembership(teamId)
        && exists(pcMembershipPath(teamId))
        && (
          get(pcMembershipPath(teamId)).data.role == 'team-admin'
          || (
            get(pcMembershipPath(teamId)).data.staffCapabilities is list
            && 'admin' in get(pcMembershipPath(teamId)).data.staffCapabilities
          )
        );
    }
    // A redeeming user may flip an invite link to redeemed for themselves without
    // being a team manager (mirrors the redeem transaction's invite-link write).
    function pcIsInviteRedemptionUpdate() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'redeemedByUserId',
          'redeemedByEmail',
          'redeemedAt',
          'redemptionCount',
          'updatedAt'
        ]);
    }

    function hasHumanUiAuditFields() {
      return request.resource.data.updatedBySource == 'human-ui'
        && request.resource.data.updatedByUid == request.auth.uid
        && request.resource.data.updatedByEmail == request.auth.token.email;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function isValidUsernameValue(value) {
      return value == null || (value is string && value.matches('^[a-z0-9_.-]{3,20}$'));
    }

    function isValidProfileImageValue(value) {
      return value == null
        || (
          value is map
          && value.profileImageURL is string
          && value.profileImageURL.size() > 0
          && value.imageOffsetWidth is number
          && value.imageOffsetHeight is number
        );
    }

    function isValidUserLevelValue(value) {
      return value == null || value in ['novice', 'intermediate', 'expert'];
    }

    function isValidSubscriptionTypeValue(value) {
      return value == null || value in [
        'Unsubscribed',
        'Team Plan Access',
        'Beta User',
        'Monthly Subscriber',
        'Annual Subscriber',
        'Sweat Equity Partner',
        'Executive Partner'
      ];
    }

    function isValidSubscriptionPlatformValue(value) {
      return value == null || value in ['ios', 'web', 'android'];
    }

    function isValidCheckinsPrivacyValue(value) {
      return value == null || value in ['privateOnly', 'followersOnly', 'publicAccess'];
    }

    function isValidLegalAcceptanceValue(value) {
      return value is map
        && value.termsVersion is string
        && value.termsVersion.size() > 0
        && value.privacyVersion is string
        && value.privacyVersion.size() > 0
        && (value.acceptedAt is timestamp || value.acceptedAt is number || value.acceptedAt is string)
        && value.acceptanceMethod is string
        && value.acceptanceMethod.size() > 0
        && value.termsPath is string
        && value.termsPath.size() > 0
        && value.privacyPath is string
        && value.privacyPath.size() > 0;
    }

    function isValidAdminDocumentCreateOrUpdate(email) {
      return request.resource.data.email == email
        && request.resource.data.keys().hasOnly([
          'email',
          'createdAt',
          'createdBy',
          'updatedAt',
          'updatedBy'
        ]);
    }

    function isPublicBetaApplicationCreate() {
      return request.resource.data.status == 'pending'
        && isNonEmptyString(request.resource.data.email)
        && isNonEmptyString(request.resource.data.name);
    }

    function isPublicProgrammingAccessCreate() {
      return request.resource.data.status == 'requested'
        && isNonEmptyString(request.resource.data.email);
    }

    function isPublicRoundExportCreate() {
      return isNonEmptyString(request.resource.data.email)
        && isNonEmptyString(request.resource.data.fileName)
        && isNonEmptyString(request.resource.data.downloadURL)
        && request.resource.data.roundData is map;
    }

    function isPublicDocumentNoteCreate() {
      return isNonEmptyString(request.resource.data.documentId)
        && isNonEmptyString(request.resource.data.authorName)
        && isNonEmptyString(request.resource.data.content)
        && request.resource.data.xPercent is number
        && request.resource.data.yOffset is number;
    }

    function isPublicSigningViewUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSignerActivityAt',
          'status',
          'updatedAt',
          'viewedAt'
        ])
        && resource.data.status != 'signed'
        && request.resource.data.status == 'viewed';
    }

    function isPublicSigningSignatureUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastSignerActivityAt',
          'signatureData',
          'signedAt',
          'status',
          'updatedAt'
        ])
        && resource.data.status != 'signed'
        && request.resource.data.status == 'signed'
        && request.resource.data.signatureData is map
        && isNonEmptyString(request.resource.data.signatureData.typedName)
        && isNonEmptyString(request.resource.data.signatureData.signatureFont);
    }

    function hasValidLegalAcceptanceOnCreate() {
      return !request.resource.data.keys().hasAny(['legalAcceptance'])
        || isValidLegalAcceptanceValue(request.resource.data.legalAcceptance);
    }

    function preservesOrValidlyUpdatesLegalAcceptance() {
      return request.resource.data.legalAcceptance == resource.data.legalAcceptance
        || isValidLegalAcceptanceValue(request.resource.data.legalAcceptance);
    }

    function isCanonicalRootUserCreate(userId) {
      return isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.email == request.auth.token.email
        && hasValidLegalAcceptanceOnCreate();
    }

    function isCanonicalRootUserUpdate(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() && request.auth.uid == userId
        && (!changed.hasAny(['pulseCheckOnboardingComplete']) || !exists(/databases/$(database)/documents/pulsecheck-private-users/$(userId)))
        && !changed.hasAny(['id', 'createdAt', 'lifetimePulsePoints', 'categoryPoints', 'creator', 'stripeCustomerIds',
          'clinicalCareState', 'crisisWallActive', 'crisisWallActivatedAt', 'crisisWallActiveEscalationId',
          'crisisWallClearReason', 'crisisWallClearedAt', 'crisisWallClearedByUserId', 'crisisWallReason'])
        && (!changed.hasAny(['email']) || request.resource.data.get('email', null) == request.auth.token.get('email', null))
        && (!changed.hasAny(['username']) || isValidUsernameValue(request.resource.data.get('username', null)))
        && (!changed.hasAny(['displayName']) || isNonEmptyString(request.resource.data.get('displayName', null)))
        && (!changed.hasAny(['birthdate']) || request.resource.data.get('birthdate', null) == null || request.resource.data.birthdate is timestamp || request.resource.data.birthdate is number)
        && (!changed.hasAny(['profileImage']) || isValidProfileImageValue(request.resource.data.get('profileImage', null)))
        && (!changed.hasAny(['registrationComplete']) || request.resource.data.get('registrationComplete', null) == true || request.resource.data.get('registrationComplete', null) == null)
        && (!changed.hasAny(['level']) || isValidUserLevelValue(request.resource.data.get('level', null)))
        && (!changed.hasAny(['subscriptionType']) || isValidSubscriptionTypeValue(request.resource.data.get('subscriptionType', null)))
        && (!changed.hasAny(['subscriptionPlatform']) || isValidSubscriptionPlatformValue(request.resource.data.get('subscriptionPlatform', null)))
        && (!changed.hasAny(['checkinsPrivacy']) || isValidCheckinsPrivacyValue(request.resource.data.get('checkinsPrivacy', null)))
        && (!changed.hasAny(['legalAcceptance']) || isValidLegalAcceptanceValue(request.resource.data.get('legalAcceptance', null)));
    }

    function isOwnedPurchaseLogCreate() {
      return isSignedIn()
        && request.resource.data.userId == request.auth.uid;
    }

    function isOwnedPurchaseLogUpdate() {
      return isSignedIn()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId;
    }

    // North Star is writable only by authenticated admin humans through the UI.
    match /company-config/north-star {
      allow read: if true;
      allow create, update: if isAdminUser()
        && isValidNorthStarPayload()
        && hasHumanUiAuditFields();
      allow delete: if false;
    }

    // Company-level config is public to read for apps, but only admins can write.
    // north-star is handled above because it has stricter audit/payload checks.
    match /company-config/{docId} {
      allow read: if true;
      allow create, update: if docId != 'north-star' && isAdminUser();
      allow delete: if false;
    }

    // Admin membership is the source of truth for admin-gated surfaces. Existing
    // admins can manage it; non-admin clients cannot grant themselves access.
    match /admin/{email} {
      allow read: if isAdminUser()
        || (hasEmail() && request.auth.token.email == email);
      allow create, update: if isAdminUser() && isValidAdminDocumentCreateOrUpdate(email);
      allow delete: if isAdminUser();
    }

    match /admin-settings/{document=**} {
      // Existing Next API routes use the client SDK server-side and do not carry
      // caller auth into Firestore. Leaving this permissive until those routes
      // move to a less brittle server auth model.
      allow read, write: if true;
    }

    // Public app/config documents can be fetched by clients but authored only by admins.
    match /{collectionName}/{document=**} {
      allow read: if isAdminManagedPublicReadCollection(collectionName);
      allow create, update, delete: if isAdminManagedPublicReadCollection(collectionName)
        && isAdminUser();
    }

    // Internal admin workspaces, CRM data, campaign data, logs, and equity records.
    match /{collectionName}/{document=**} {
      allow read, create, update, delete: if isAdminOnlyCollection(collectionName)
        && collectionName != 'equity-documents'
        && isAdminUser();
    }

    // An EIP is a retained corporate record. Revisions get a new document ID;
    // draft signing metadata may change until approval. Approved and legacy
    // auto-executed records retain all saved approval and signature evidence.
    // Admin SDK writes bypass rules and must enforce the same policy server-side.
    match /equity-documents/{documentId} {
      function isEip(data) {
        return data.get('documentType', '') == 'eip';
      }
      function unsignedDraft(data) {
        return data.get('approvalStatus', '') == 'draft'
          && data.get('autoSigned', false) == false
          && data.get('autoSignedAt', null) == null;
      }
      function approvalEvidenceExists(data) {
        return data.get('approvalStatus', '') == 'approved'
          || data.get('autoSigned', false) == true
          || data.get('autoSignedAt', null) != null;
      }
      function signingMetadataOnly() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'signingRequestId', 'signingRequestIds', 'requiresSignature',
          'needsResendSignature', 'status', 'approvalStatus', 'approvedAt',
          'approvedBy', 'updatedAt', 'errorMessage'
        ]);
      }
      function completesNewDraft() {
        return resource.data.get('status', '') == 'generating'
          && resource.data.get('content', '') == ''
          && unsignedDraft(resource.data)
          && unsignedDraft(request.resource.data)
          && request.resource.data.get('status', '') == 'completed'
          && request.resource.data.get('content', '') is string
          && request.resource.data.get('content', '').size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'content', 'title', 'legalTemplateVersion', 'requiresSignature',
            'status', 'updatedAt', 'errorMessage'
          ]);
      }
      allow read: if isAdminUser();
      allow create: if isAdminUser()
        && (!isEip(request.resource.data) || unsignedDraft(request.resource.data));
      allow update: if isAdminUser() && (
        (!isEip(resource.data) && !isEip(request.resource.data))
        || (isEip(resource.data) && isEip(request.resource.data)
          && !approvalEvidenceExists(resource.data)
          && (signingMetadataOnly() || completesNewDraft()))
      );
      allow delete: if isAdminUser() && !isEip(resource.data);
    }

    // Purchase observability. The apps write their own purchase attempts,
    // successes, failures, cancellations, and cancel reasons; admins can review
    // all product logs from the Purchase Logs admin page.
    match /{collectionName}/{logId} {
      allow read: if isPurchaseLogCollection(collectionName)
        && (
          isAdminUser()
          || (isSignedIn() && resource.data.userId == request.auth.uid)
        );
      allow create: if isPurchaseLogCollection(collectionName)
        && (isAdminUser() || isOwnedPurchaseLogCreate());
      allow update: if isPurchaseLogCollection(collectionName)
        && (isAdminUser() || isOwnedPurchaseLogUpdate());
      allow delete: if isPurchaseLogCollection(collectionName)
        && isAdminUser();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdminUser();
    }

    match /payments/{paymentId} {
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.buyerId == request.auth.uid);
      allow create, update, delete: if isAdminUser();
    }

    match /beta/{email} {
      allow read: if isAdminUser()
        || (hasEmail() && resource.data.email == request.auth.token.email)
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdminUser();
    }

    match /beta-applications/{applicationId} {
      allow read: if isAdminUser();
      allow create: if isAdminUser() || isPublicBetaApplicationCreate();
      allow update, delete: if isAdminUser();
    }

    match /programming-access/{requestId} {
      allow read: if isAdminUser()
        || (hasEmail() && resource.data.email == request.auth.token.email);
      allow create: if isAdminUser() || isPublicProgrammingAccessCreate();
      allow update, delete: if isAdminUser();
    }

    match /round-exports/{exportId} {
      allow read, update, delete: if isAdminUser();
      allow create: if isPublicRoundExportCreate();
    }

    match /user-reports/{reportId} {
      allow read, update, delete: if isAdminUser();
      allow create: if isSignedIn()
        && request.resource.data.reportedBy == request.auth.uid;
    }

    match /document-notes/{noteId} {
      allow read: if true;
      allow create: if isPublicDocumentNoteCreate();
      allow delete: if true;
      allow update: if false;
    }

    match /signingRequests/{requestId} {
      allow get, list: if true;
      allow create, delete: if isAdminUser();
      allow update: if isAdminUser()
        || isPublicSigningViewUpdate()
        || isPublicSigningSignatureUpdate();
    }

    // User documents: allow clients to set partnerSource only at creation.
    // After creation, partnerSource is treated as immutable and can only be
    // changed by trusted backends using the Admin SDK (which bypasses rules).
    match /users/{userId} {
      // Preserve the prior generic write behavior for unrelated, unmarked accounts.
      allow create, update, delete: if isAdminUser() || (isSignedIn()
        && !exists(/databases/$(database)/documents/pulsecheck-private-users/$(userId)));
      allow create: if isCanonicalRootUserCreate(userId);

      allow update: if isCanonicalRootUserUpdate(userId);

      allow read: if !exists(/databases/$(database)/documents/pulsecheck-private-users/$(userId))
        || (isSignedIn() && (request.auth.uid == userId || isAdminUser()));
    }

    // Preserve existing non-token nested behavior while protecting cohort-owned data.
    match /users/{userId}/{subcollection}/{nested=**} {
      allow read, write: if subcollection != 'pulsecheckPushTokens' && isSignedIn()
        && (!exists(/databases/$(database)/documents/pulsecheck-private-users/$(userId))
          || request.auth.uid == userId || isAdminUser());
    }

    // Train Nora knowledge vault. Each entry is owned by the coach whose uid
    // equals coachId. The owning coach manages their entries; any signed-in
    // user (e.g. a linked athlete's Nora) may read so it can answer questions
    // from the coach's shared context.
    match /coach-nora-vault/{entryId} {
      allow read: if isSignedIn() && pcLifecycleScopeOpen(resource.data);
      allow create: if isSignedIn() && pcLifecycleScopeOpen(request.resource.data)
        && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isSignedIn() && pcLifecycleScopeOpen(resource.data)
        && resource.data.coachId == request.auth.uid;
    }

    // Team schedule (Coach Dashboard v2 → Schedule tab). Same ownership model as
    // the Nora vault: any signed-in athlete/coach can read, only the owning coach
    // can write. Athlete-facing Nora reads these to answer "when's our next meet?".
    match /coach-team-schedule/{eventId} {
      allow read: if isSignedIn() && pcLifecycleScopeOpen(resource.data);
      allow create: if isSignedIn() && pcLifecycleScopeOpen(request.resource.data)
        && request.resource.data.coachId == request.auth.uid;
      allow update, delete: if isSignedIn() && pcLifecycleScopeOpen(resource.data)
        && resource.data.coachId == request.auth.uid;
    }

    // PulseCheck staff invites. Reads stay open to signed-in clients (a not-yet-
    // member must read an invite to redeem it; the dashboard lists a team's links),
    // but only an admin or a manager of the link's team may issue or change one. A
    // redeeming user may mark their own redemption. The redeem API route uses the
    // Admin SDK and bypasses these rules.
    match /pulsecheck-invite-links/{inviteId} {
      allow read: if isAdminUser() || (isSignedIn() && pcLifecycleScopeOpen(resource.data));
      allow create: if isAdminUser() || pcCanManageTeam(request.resource.data.teamId);
      allow update: if isAdminUser()
        || pcCanManageTeam(resource.data.teamId)
        || (pcIsInviteRedemptionUpdate() && pcLifecycleScopeOpen(resource.data));
      allow delete: if isAdminUser() || pcCanManageTeam(resource.data.teamId);
    }

    // PulseCheck team memberships (staff + athletes). Reads stay open to signed-in
    // clients (iOS and the dashboard read memberships broadly). A user may write
    // their own membership (onboarding / redemption), a team manager may adjust
    // access for members of their team, and admins can do anything.
    // Consent summaries live on memberships. Discover your own records freely;
    // other records require active, persisted staff authority and roster scope.
    function pcConsentActive(data) {
      return data.get('status', 'active') == 'active'
        && data.get('revokedAt', null) == null
        && data.get('archivedAt', null) == null
        && data.get('deletedAt', null) == null;
    }
    function pcConsentStaff(teamId) {
      let staff = get(pcMembershipPath(teamId)).data;
      let team = get(/databases/$(database)/documents/pulsecheck-teams/$(teamId)).data;
      let organization = get(/databases/$(database)/documents/pulsecheck-organizations/$(team.organizationId)).data;
      return isSignedIn()
        && staff.userId == request.auth.uid && staff.teamId == teamId
        && staff.organizationId == team.organizationId
        && pcConsentActive(staff) && pcConsentActive(team) && pcConsentActive(organization)
        && team.status == 'active' && organization.status == 'active'
        && staff.role in ['team-admin', 'coach', 'support-staff', 'performance-staff', 'clinician']
        && (!('staffCapabilities' in staff)
          || (staff.staffCapabilities is list
            && staff.staffCapabilities.hasAny(['admin', 'coaching', 'administrative', 'athletic_trainer'])));
    }
    function pcConsentCanReadMember(data) {
      let staff = get(pcMembershipPath(data.teamId)).data;
      return pcConsentStaff(data.teamId)
        && (staff.get('rosterVisibilityScope', 'team') == 'team'
          || (staff.get('rosterVisibilityScope', 'team') == 'assigned'
            && data.userId in staff.get('allowedAthleteIds', [])));
    }
    function pcConsentManager(teamId) {
      let staff = get(pcMembershipPath(teamId)).data;
      return pcConsentStaff(teamId)
        && ((!('staffCapabilities' in staff) && staff.role == 'team-admin')
          || ('admin' in staff.get('staffCapabilities', [])));
    }
    function pcConsentSameIdentity() {
      return request.resource.data.userId == resource.data.userId
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.organizationId == resource.data.organizationId;
    }
    function pcConsentOwnerStateIsSafe() {
      let before = resource.data.get('athleteOnboarding', {});
      let after = request.resource.data.get('athleteOnboarding', {});
      return after.get('targetPilotId', '') == before.get('targetPilotId', '')
        && after.get('targetCohortId', '') == before.get('targetCohortId', '')
        && after.get('consentPersistenceVersion', 0) == before.get('consentPersistenceVersion', 0)
        && (before.get('consentPersistenceVersion', 0) < 2
          || (after.diff(before).affectedKeys().hasOnly(['baselinePathStatus', 'baselinePathwayId'])
            && request.resource.data.get('onboardingStatus', '') == resource.data.get('onboardingStatus', '')));
    }
    function pcConsentOwnUpdate() {
      return isSignedIn() && resource.data.userId == request.auth.uid
        && pcConsentSameIdentity() && pcConsentOwnerStateIsSafe()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'athleteAge', 'athleteOnboarding', 'coachIntakeCompletedAt',
          'coachIntakeFormVersion', 'coachIntakeResponses', 'notificationPreferences',
          'onboardingStatus', 'phone', 'postActivationCompletedAt', 'smsConsentAt',
          'staffConsentDecisions', 'staffConsentRecordedAt', 'title', 'updatedAt'
        ]);
    }
    match /pulsecheck-team-memberships/{membershipId} {
      match /consent-events/{eventId} {
        allow read: if isSignedIn() && get(/databases/$(database)/documents/pulsecheck-team-memberships/$(membershipId)).data.userId == request.auth.uid;
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/pulsecheck-team-memberships/$(membershipId)).data.userId == request.auth.uid
          && request.resource.data.actorUserId == request.auth.uid
          && request.resource.data.recordedAt == request.time
          && request.resource.data.keys().hasOnly(['actorUserId', 'decisions', 'recordedAt']);
        allow update, delete: if false;
      }
      allow read: if isAdminUser() || (isSignedIn()
        && (resource.data.userId == request.auth.uid || pcConsentCanReadMember(resource.data)));
      // Self-service invitations use the authenticated server redeem API. A user
      // cannot invent a staff grant to bypass the scoped read policy above.
      allow create: if isAdminUser() || (pcConsentManager(request.resource.data.teamId)
        && membershipId == request.resource.data.teamId + '_' + request.resource.data.userId
        && request.resource.data.organizationId == get(/databases/$(database)/documents/pulsecheck-teams/$(request.resource.data.teamId)).data.organizationId);
      allow update: if isAdminUser() || pcConsentOwnUpdate()
        || (pcConsentManager(resource.data.teamId) && pcConsentSameIdentity());
      allow delete: if isAdminUser() || pcConsentManager(resource.data.teamId);
    }

    // PulseCheck invite activity log (page views, redemption events, email sends).
    // Low-sensitivity telemetry: signed-in clients may append and read; only admins
    // may mutate or remove existing entries.
    match /pulsecheck-invite-activities/{activityId} {
      allow read: if isAdminUser() || (isSignedIn() && pcLifecycleScopeOpen(resource.data));
      allow create: if isSignedIn() && pcLifecycleScopeOpen(request.resource.data);
      allow update, delete: if isAdminUser();
    }

    // Curriculum plans, journals, and state are served only by authenticated APIs.
    match /pulsecheck-linear-curriculum/{document=**} { allow read, write: if false; }

    // Compatibility fallback: unknown collections are no longer public. They
    // remain available to signed-in clients unless a stricter rule exists above.
    function pcHasLinearState(owner) {
      return owner is string && owner.size() > 0
        && exists(/databases/$(database)/documents/pulsecheck-linear-curriculum/states/items/$(owner));
    }
    function pcLegacyOwnerEnrolled(data) {
      return pcHasLinearState(data.get('athleteUserId', ''))
        || pcHasLinearState(data.get('athleteId', ''))
        || pcHasLinearState(data.get('userId', ''));
    }
    function pcLegacyExecuting(data) {
      return data.get('status', '') in ['started', 'in_progress', 'inProgress', 'paused']
        || (!(data.get('status', '') in ['completed', 'done', 'expired', 'superseded', 'overridden', 'deferred', 'skipped', 'cancelled', 'canceled'])
          && data.get('startedAt', 0) is number && data.get('startedAt', 0) > 0);
    }
    function pcLegacyAssignmentWriteAllowed(collectionName) {
      return !(collectionName in ['pulsecheck-daily-assignments', 'sim-assignments', 'mental-exercise-assignments'])
        || ((collectionName != 'pulsecheck-daily-assignments' || (!pcLegacyOwnerEnrolled(request.resource.data) && (resource == null || !pcLegacyOwnerEnrolled(resource.data))))
          && request.resource.data.get('source', '') != 'standalone_reservation'
          && (resource == null || resource.data.get('source', '') != 'standalone_reservation')
          && (resource == null || (!pcLegacyOwnerEnrolled(resource.data) && !pcLegacyExecuting(resource.data))
            || (request.resource.data.get('athleteUserId', '') == resource.data.get('athleteUserId', '')
              && request.resource.data.get('athleteId', '') == resource.data.get('athleteId', '')
              && request.resource.data.get('userId', '') == resource.data.get('userId', '')))
          && (!pcLegacyExecuting(request.resource.data)
          || (!pcHasLinearState(request.auth.uid)
            && !pcLegacyOwnerEnrolled(request.resource.data)
            && (resource == null || !pcLegacyOwnerEnrolled(resource.data)))));
    }

    // Partner credentials, snapshots, and protected documentation are server-only.
    match /partner-api-access-requests/{document=**} { allow read, write: if false; }
    match /partner-api-keys/{document=**} { allow read, write: if false; }
    match /partner-api-key-audit/{document=**} { allow read, write: if false; }
    match /partner-api-key-rate-limits/{document=**} { allow read, write: if false; }
    match /developerDocsUnlockAttempts/{document=**} { allow read, write: if false; }
    match /systemOverviewShareLinks/{document=**} { allow read, write: if false; }
    match /systemOverviewShareUnlockAttempts/{document=**} { allow read, write: if false; }
    match /athleticmind-snapshot-pulls/{document=**} { allow read, write: if false; }
    match /athleticmind-snapshots/{document=**} { allow read, write: if false; }
    match /athleticmind-snapshot-deliveries/{document=**} { allow read, write: if false; }
    match /athleticmind-snapshot-watermarks/{document=**} { allow read, write: if false; }
    match /athleticmind-snapshot-scheduler/{document=**} { allow read, write: if false; }

    // Individual booking records and management tokens are API-only.
    match /groupMeetBookingSettings/{document=**} { allow read, write: if false; }
    match /groupMeetBookings/{document=**} { allow read, write: if false; }
    match /groupMeetBookingLimits/{document=**} { allow read, write: if false; }
    match /coach-team-insight-reports/{document=**} { allow read, write: if false; }

    match /{collectionName}/{document=**} {
      allow read: if isSignedIn()
        && !isExplicitlyRuledCollection(collectionName)
        && (resource == null || pcLifecycleScopeOpen(resource.data));
      allow create, update: if isSignedIn()
        && !isExplicitlyRuledCollection(collectionName)
        && pcLifecycleScopeOpen(request.resource.data)
        && (resource == null || pcLifecycleScopeOpen(resource.data))
        && pcLegacyAssignmentWriteAllowed(collectionName);
      allow delete: if isSignedIn()
        && !isExplicitlyRuledCollection(collectionName)
        && pcLifecycleScopeOpen(resource.data)
        && (!(collectionName in ['pulsecheck-daily-assignments', 'sim-assignments', 'mental-exercise-assignments']) || (resource.data.get('source', '') != 'standalone_reservation' && !pcLegacyOwnerEnrolled(resource.data) && !pcLegacyExecuting(resource.data)));
    }
    match /pulsecheck-restricted-questionnaire-submissions/{document=**} { allow read, write: if false; }

    // Private evidence is accessed only through the owner-authorized API.
    match /pulsecheck-evidence-journals/{document=**} {
      allow read, write: if false;
    }
    function pcPushInstallationIdIsValid(installationId) {
      return installationId is string
        && installationId.matches('^[A-Za-z0-9_-]{20,128}$');
    }
    function pcPushInstallationDataIsValid(data, ownerUserId, installationId) {
      return data.keys().hasAll([
          'ownerUserId',
          'installationId',
          'token',
          'sourceApp',
          'platform',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerUserId',
          'installationId',
          'token',
          'sourceApp',
          'platform',
          'createdAt',
          'updatedAt'
        ])
        && pcPushInstallationIdIsValid(installationId)
        && data.ownerUserId == ownerUserId
        && data.installationId == installationId
        && data.token is string
        && data.token.size() > 0
        && data.token.size() <= 4096
        && data.sourceApp == 'pulsecheck'
        && data.platform in ['ios', 'ipados', 'android', 'web']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }
    function pcPushInstallationCreateIsValid(ownerUserId, installationId) {
      return pcPushInstallationDataIsValid(
          request.resource.data,
          ownerUserId,
          installationId
        )
        && request.resource.data.createdAt == request.time;
    }
    function pcPushInstallationUpdateIsValid(ownerUserId, installationId) {
      return pcPushInstallationDataIsValid(
          request.resource.data,
          ownerUserId,
          installationId
        )
        && (
          request.resource.data.createdAt == resource.data.createdAt
          || request.resource.data.createdAt == request.time
        );
    }
    match /users/{userId}/pulsecheckPushTokens/{installationId} {
      allow read: if isAdminUser()
        || (isSignedIn() && request.auth.uid == userId);
      allow create: if isAdminUser()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && pcPushInstallationCreateIsValid(userId, installationId)
        );
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && resource.data.ownerUserId == userId
          && pcPushInstallationUpdateIsValid(userId, installationId)
        );
      allow delete: if isAdminUser()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && resource.data.ownerUserId == userId
        );
    }

    match /pulsecheck-push-installations/{installationId} {
      allow read: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
        );
      allow create: if isAdminUser()
        || (
          isSignedIn()
          && request.resource.data.ownerUserId == request.auth.uid
          && pcPushInstallationCreateIsValid(
            request.auth.uid,
            installationId
          )
        );
      // The random, device-persisted installation id is possession proof for
      // an account switch. A delayed delete from the previous owner cannot
      // remove the new owner's claim.
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && request.resource.data.ownerUserId == request.auth.uid
          && pcPushInstallationUpdateIsValid(
            request.auth.uid,
            installationId
          )
        );
      allow delete: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.ownerUserId == request.auth.uid
        );
    }


    // Durable closure and delivery state are owned exclusively by trusted services.
    match /pulsecheck-private-users/{document=**} { allow read, write: if false; }
    match /account-closure-jobs/{document=**} { allow read, write: if false; }
    match /pulsecheck-invite-accepted-outbox/{document=**} { allow read, write: if false; }
    // Responder projection and acknowledgement use authenticated server routes.
    match /pulsecheck-clinical-escalations/{escalationId} {
      allow read, write: if false;
      match /athleteAcknowledgements/{acknowledgementId} {
        allow create: if isSignedIn()
          && get(/databases/$(database)/documents/pulsecheck-clinical-escalations/$(escalationId)).data.athleteUserId == request.auth.uid
          && request.resource.data.keys().hasOnly(['athleteUserId', 'acknowledgedAt'])
          && request.resource.data.athleteUserId == request.auth.uid
          && request.resource.data.acknowledgedAt == request.time;
        allow read, update, delete: if false;
      }
    }
    // Raw escalation evidence is private; ordinary care requires current tenant scope.
    function pcEscalationActive(data) {
      return data.get('status', '') == 'active'
        && data.get('revokedAt', null) == null && data.get('archivedAt', null) == null
        && data.get('deletedAt', null) == null && data.get('revoked', false) == false;
    }
    function pcEscalationCareAccess(data, athleteId) {
      let teamId = data.get('teamId', '');
      let orgId = data.get('organizationId', '');
      let team = get(/databases/$(database)/documents/pulsecheck-teams/$(teamId)).data;
      let org = get(/databases/$(database)/documents/pulsecheck-organizations/$(orgId)).data;
      let staff = get(/databases/$(database)/documents/pulsecheck-team-memberships/$(teamId + '_' + request.auth.uid)).data;
      let athlete = get(/databases/$(database)/documents/pulsecheck-team-memberships/$(teamId + '_' + athleteId)).data;
      return data.get('tier', 0) != 3 && data.get('tier', 0) != '3'
        && data.get('classificationFamily', '') != 'critical_safety'
        && data.get('productBrand', '') != 'athleticmind'
        && org.get('productBrand', '') == 'pulsecheck'
        && team.organizationId == orgId && pcEscalationActive(team) && pcEscalationActive(org)
        && pcEscalationActive(staff) && pcEscalationActive(athlete)
        && staff.userId == request.auth.uid && athlete.userId == athleteId
        && staff.teamId == teamId && athlete.teamId == teamId
        && staff.organizationId == orgId && athlete.organizationId == orgId
        && athlete.role == 'athlete' && staff.role != 'athlete'
        && (('staffCapabilities' in staff
            && staff.staffCapabilities is list
            && staff.staffCapabilities.hasAny(['admin', 'coaching', 'athletic_trainer']))
          || (!('staffCapabilities' in staff) && staff.role in ['team-admin', 'coach']))
        && (staff.get('rosterVisibilityScope', 'team') == 'team'
          || (staff.get('rosterVisibilityScope', '') == 'assigned'
            && athleteId in staff.get('allowedAthleteIds', [])));
    }
    match /escalation-records/{escalationId} {
      allow read: if isSignedIn() && (
        resource.data.get('userId', resource.data.get('athleteId', resource.data.get('athleteUserId', ''))) == request.auth.uid
        || pcEscalationCareAccess(resource.data, resource.data.get('userId', resource.data.get('athleteId', resource.data.get('athleteUserId', '')))));
      allow write: if false;
    }
    match /mental-check-ins/{athleteId}/{document=**} {
      allow read, write: if isAdminUser() || (isSignedIn() && request.auth.uid == athleteId);
    }

    match /pulsecheck-morning-checkins/{checkInId} {
      // Raw personal records stay with the athlete. Staff dashboard access is
      // projected by the authenticated team-dashboard API, never this document.
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      // Trusted check-in services create the canonical row. The athlete's
      // merge write below may enrich only a row that already exists.
      allow create: if isAdminUser();
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.athleteUserId == request.auth.uid
          && request.resource.data.athleteUserId
            == resource.data.athleteUserId
          && (
            (
              !('teamId' in resource.data)
              && !('teamId' in request.resource.data)
            )
            || request.resource.data.teamId == resource.data.teamId
          )
          && (
            (
              !('organizationId' in resource.data)
              && !('organizationId' in request.resource.data)
            )
            || request.resource.data.organizationId
              == resource.data.organizationId
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'energyReset'
          ])
          && request.resource.data.energyReset is map
        );
      allow delete: if isAdminUser();
    }

    // Derived sentiment is backend-owned. Existing unscoped records remain
    // visible to their athlete; team staff only receive exact scoped records.
    match /dailySentimentAnalysis/{sentimentId} {
      // Raw personal records stay with the athlete. Staff dashboard access is
      // projected by the authenticated team-dashboard API, never this document.
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if isAdminUser();
    }

    // Raw device records are owned by the athlete adapter. Identity and source
    // provenance cannot change after creation. A team-scoped server projection
    // may also be read by active authorized care/coaching staff.
    match /health-context-source-records/{recordId} {
      // Raw personal records stay with the athlete. Staff dashboard access is
      // projected by the authenticated team-dashboard API, never this document.
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      allow create: if isAdminUser()
        || (
          isSignedIn()
          && recordId.matches('^' + request.auth.uid + '_.*$')
          && request.resource.data.id == recordId
          && request.resource.data.athleteUserId == request.auth.uid
          && request.resource.data.sourceFamily is string
          && request.resource.data.sourceType is string
          && !('teamId' in request.resource.data)
          && !('organizationId' in request.resource.data)
        );
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.athleteUserId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.athleteUserId
            == resource.data.athleteUserId
          && request.resource.data.sourceFamily
            == resource.data.sourceFamily
          && request.resource.data.sourceType == resource.data.sourceType
          && (
            (
              !('teamId' in resource.data)
              && !('teamId' in request.resource.data)
            )
            || (
              request.resource.data.teamId == resource.data.teamId
              && request.resource.data.organizationId
                == resource.data.organizationId
            )
          )
        );
      allow delete: if isAdminUser();
    }

    // Source lifecycle rows use `{athleteUserId}_{sourceFamily}`. Athletes can
    // connect, refresh, and remove only their own device-family status.
    match /health-context-source-status/{statusId} {
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      allow create: if isAdminUser()
        || (
          isSignedIn()
          && request.resource.data.id == statusId
          && request.resource.data.athleteUserId == request.auth.uid
          && request.resource.data.sourceFamily is string
          && statusId == request.auth.uid + '_'
            + request.resource.data.sourceFamily
          && !('teamId' in request.resource.data)
          && !('organizationId' in request.resource.data)
        );
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.athleteUserId == request.auth.uid
          && request.resource.data.id == resource.data.id
          && request.resource.data.athleteUserId
            == resource.data.athleteUserId
          && request.resource.data.sourceFamily
            == resource.data.sourceFamily
          && (
            (
              !('teamId' in resource.data)
              && !('teamId' in request.resource.data)
            )
            || (
              request.resource.data.teamId == resource.data.teamId
              && request.resource.data.organizationId
                == resource.data.organizationId
            )
          )
        );
      allow delete: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.athleteUserId == request.auth.uid
          && statusId == request.auth.uid + '_'
            + resource.data.sourceFamily
        );
    }

    // Canonical daily snapshots may be assembled by the signed-in native
    // HealthKit bridge or trusted backend adapters. Athletes can only write
    // their own deterministic rows; staff access requires server-attached
    // team and organization scope.
    match /health-context-snapshots/{snapshotId} {
      // Raw personal records stay with the athlete. Staff dashboard access is
      // projected by the authenticated team-dashboard API, never this document.
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      allow create: if isAdminUser()
        || (
          isSignedIn()
          && snapshotId.matches('^' + request.auth.uid + '_.*$')
          && request.resource.data.athleteUserId == request.auth.uid
          && !('teamId' in request.resource.data)
          && !('organizationId' in request.resource.data)
        );
      allow update: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.athleteUserId == request.auth.uid
          && request.resource.data.athleteUserId == resource.data.athleteUserId
          && (
            (
              !('teamId' in resource.data)
              && !('teamId' in request.resource.data)
            )
            || (
              'teamId' in resource.data
              && 'teamId' in request.resource.data
              && request.resource.data.teamId == resource.data.teamId
            )
          )
          && (
            (
              !('organizationId' in resource.data)
              && !('organizationId' in request.resource.data)
            )
            || (
              'organizationId' in resource.data
              && 'organizationId' in request.resource.data
              && request.resource.data.organizationId == resource.data.organizationId
            )
          )
        );
      allow delete: if isAdminUser();
    }

    match /health-context-snapshot-revisions/{revisionId} {
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      allow create, update: if isAdminUser()
        || (
          isSignedIn()
          && revisionId.matches('^' + request.auth.uid + '_.*$')
          && request.resource.data.athleteUserId == request.auth.uid
        );
      allow delete: if isAdminUser();
    }

    match /health-context-assembly-traces/{traceId} {
      allow read: if isAdminUser()
        || (isSignedIn() && resource.data.athleteUserId == request.auth.uid);
      allow create, update: if isAdminUser()
        || (
          isSignedIn()
          && traceId.matches('^' + request.auth.uid + '_.*$')
          && request.resource.data.athleteUserId == request.auth.uid
        );
      allow delete: if isAdminUser();
    }

    match /pulsecheck-daily-assignments/{assignmentId} {
      allow get: if isSignedIn() && resource == null && assignmentId.matches('^' + request.auth.uid + '_.*$');
      allow read: if isAdminUser() || (isSignedIn() && resource.data.athleteId == request.auth.uid);
      allow create, delete: if isAdminUser();
      allow update: if isAdminUser() || (isSignedIn()
        && resource.data.athleteId == request.auth.uid
        && request.resource.data.athleteId == resource.data.athleteId
        && !pcLegacyOwnerEnrolled(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['protocolPracticeSession', 'updatedAt']));
    }
    match /pulsecheck-training-plans/{planId} {
      allow read: if isAdminUser() || (isSignedIn() && resource.data.athleteId == request.auth.uid);
      allow create: if isAdminUser() || (isSignedIn() && request.resource.data.athleteId == request.auth.uid);
      allow update: if isAdminUser() || (isSignedIn() && resource.data.athleteId == request.auth.uid && request.resource.data.athleteId == resource.data.athleteId);
      allow delete: if isAdminUser() || (isSignedIn() && resource.data.athleteId == request.auth.uid);
    }
    match /{assignmentCollection}/{assignmentId} {
      allow read: if assignmentCollection in ['sim-assignments', 'mental-exercise-assignments']
        && (isAdminUser() || (isSignedIn() && resource.data.athleteUserId == request.auth.uid));
      allow create, update: if assignmentCollection in ['sim-assignments', 'mental-exercise-assignments']
        && isSignedIn() && (isAdminUser() || (request.resource.data.athleteUserId == request.auth.uid
          && (resource == null || resource.data.athleteUserId == request.auth.uid)))
        && pcLegacyAssignmentWriteAllowed(assignmentCollection);
      allow delete: if assignmentCollection in ['sim-assignments', 'mental-exercise-assignments']
        && isSignedIn() && (isAdminUser() || resource.data.athleteUserId == request.auth.uid)
        && resource.data.get('source', '') != 'standalone_reservation'
        && !pcLegacyOwnerEnrolled(resource.data) && !pcLegacyExecuting(resource.data);
    }
    match /pulsecheck-athlete-safety-state/{athleteUserId} {
      allow read: if isSignedIn() && request.auth.uid == athleteUserId;
      allow write: if false;
    }
    match /pulsecheck-pilot-enrollments/{enrollmentId} {
      allow read: if isAdminUser() || (isSignedIn() && resource.data.userId == request.auth.uid)
        || pcConsentCanReadMember(resource.data);
      allow create, delete: if isAdminUser();
      allow update: if isAdminUser() || (isSignedIn() && resource.data.userId == request.auth.uid
        && resource.data.get('status', 'pending-consent') in ['active', 'pending-consent']
        && pcConsentActive(get(/databases/$(database)/documents/pulsecheck-team-memberships/$(resource.data.teamMembershipId)).data)
        && get(/databases/$(database)/documents/pulsecheck-team-memberships/$(resource.data.teamMembershipId)).data.userId == request.auth.uid
        && resource.data.get('consentPersistenceVersion', 0) < 2
        && request.resource.data.get('consentPersistenceVersion', 0) < 2
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.pilotId == resource.data.pilotId
        && request.resource.data.get('cohortId', '') == resource.data.get('cohortId', '')
        && request.resource.data.teamMembershipId == resource.data.teamMembershipId);
    }

    // Provider credentials and OAuth handshakes are never client-readable.
    match /pulsecheck-oura-connections/{document=**} { allow read, write: if false; }
    match /pulsecheck-whoop-connections/{document=**} { allow read, write: if false; }
    match /pulsecheck-polar-connections/{document=**} { allow read, write: if false; }
    match /health-provider-connections/{document=**} { allow read, write: if false; }
    match /pulsecheck-oauth-states/{document=**} { allow read, write: if false; }

    // Raw Nora text and inferred state are private to the athlete; authenticated APIs author them.
    match /conversations/{conversationId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if false;
    }
    match /conversationSummaries/{conversationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }
    match /user-mental-notes/{userId}/notes/{noteId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if false;
    }
    match /state-snapshots/{snapshotId} {
      // Startup probes a not-yet-created daily snapshot before requesting server repair.
      allow get: if isSignedIn() && !exists(/databases/$(database)/documents/state-snapshots/$(snapshotId));
      allow read: if isSignedIn() && resource.data.athleteId == request.auth.uid;
      allow write: if false;
    }
    match /conversation-derived-signal-events/{eventId} {
      allow read: if isSignedIn() && resource.data.athleteId == request.auth.uid;
      allow write: if false;
    }

    match /pulsecheck-organizations/{organizationId} {
      match /lifecycle-jobs/{jobId} {
        allow read, write: if false;
      }
      allow read: if isAdminUser() || (isSignedIn() && resource.data.get('lifecycleState', null) == null && resource.data.get('deletedAt', null) == null);
      // The authenticated lifecycle endpoint owns deletion and restoration.
      allow create: if isAdminUser()
        && !request.resource.data.keys().hasAny(['lifecycleState', 'deletedAt', 'purgeAfter', 'previousStatus', 'deletedBy', 'purgedAt']);
      allow update: if isAdminUser()
        && resource.data.get('lifecycleState', null) == null
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['lifecycleState', 'deletedAt', 'purgeAfter', 'previousStatus', 'deletedBy', 'purgedAt']);
      allow delete: if false;
    }
    match /pulsecheck-teams/{teamId} {
      allow read: if isAdminUser() || (isSignedIn() && pcOrganizationNotDecommissioned(resource.data.organizationId));
      allow create: if isAdminUser() && pcOrganizationNotDecommissioned(request.resource.data.organizationId);
      allow delete: if isAdminUser() && pcOrganizationNotDecommissioned(resource.data.organizationId);
      // Commercial and billing switches grant paid or sponsored app access.
      // Coaches manage athlete pricing through the authenticated server route;
      // only platform admins may write commercialConfig directly.
      allow update: if (isAdminUser()
          && pcOrganizationNotDecommissioned(resource.data.organizationId)
          && pcOrganizationNotDecommissioned(request.resource.data.organizationId))
        || (
          pcCanManageTeam(teamId)
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'defaultAdminEmail',
            'defaultAdminName',
            'defaultAdminUserIds',
            'defaultInvitePolicy',
            'displayName',
            'notes',
            'sportOrProgram',
            'teamType',
            'updatedAt'
          ])
        );
    }
    match /pulsecheck-pilots/{pilotId} {
      allow read: if isAdminUser() || (isSignedIn() && pcOrganizationNotDecommissioned(resource.data.organizationId));
      allow create: if isAdminUser()
        || (
          pcCanManageTeam(request.resource.data.teamId)
          && pcTeamScopedDataIsActive(request.resource.data)
        );
      allow update: if isAdminUser()
        || (
          pcCanManageTeam(resource.data.teamId)
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.organizationId == resource.data.organizationId
        );
      allow delete: if isAdminUser() || pcCanManageTeam(resource.data.teamId);
    }
    match /pulsecheck-pilot-cohorts/{cohortId} {
      allow read: if isAdminUser() || (isSignedIn() && pcOrganizationNotDecommissioned(resource.data.organizationId));
      allow create: if isAdminUser()
        || (
          pcCanManageTeam(request.resource.data.teamId)
          && pcTeamScopedDataIsActive(request.resource.data)
        );
      allow update: if isAdminUser()
        || (
          pcCanManageTeam(resource.data.teamId)
          && request.resource.data.teamId == resource.data.teamId
          && request.resource.data.organizationId == resource.data.organizationId
          && request.resource.data.pilotId == resource.data.pilotId
        );
      allow delete: if isAdminUser() || pcCanManageTeam(resource.data.teamId);
    }
    match /pulsecheck-organization-memberships/{membershipId} {
      allow read: if isAdminUser()
        || (
          isSignedIn()
          && resource.data.userId == request.auth.uid
        );
      allow create, update, delete: if isAdminUser();
    }
  }
}
